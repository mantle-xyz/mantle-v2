# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Archive node used as both the state source and the reference. Must serve the whole
# range: historical state, receipts, and debug_getRawTransaction.
MANTLE_URL=http://your-archive-node:8545

# 5000 = Mantle mainnet, 5003 = Mantle sepolia. Selects the fork schedule below;
# any other value is rejected.
CHAIN_ID=5000

# Inclusive block range.
START_BLOCK=94355444
END_BLOCK=94365443

# ---------------------------------------------------------------------------
# Fork selection
# ---------------------------------------------------------------------------

# LEAVE THIS EMPTY. Each block's fork is then taken from its own timestamp, which is
# the only way a range crossing an activation replays correctly, and for any block at
# or after Arsia it yields Arsia -- the newest fork Mantle has.
#
# Setting it pins every block in the range to one fork. That is a debugging tool: pin
# it to reproduce one block under a different fork, never to replay a range.
#
# Mantle fork -> OpSpecId -> Ethereum SpecId, and where each activates:
#
#   Mantle fork    OpSpecId   eth SpecId   mainnet        sepolia
#   -----------    --------   ----------   -----------    ----------
#   Arsia          Arsia      Osaka        94,355,444     36,438,664   <- newest
#   Limb           Osaka      Osaka        90,121,844     31,600,264
#   Skadi          Isthmus    Prague       84,073,844     25,552,264
#   Euboea         -          -            not modelled
#   Everest        -          -            not modelled
#   MantleBaseFee  -          -            not modelled
#
# Blocks below Skadi fall back to Bedrock, which is wrong for Mantle, so they mismatch
# by design. reth's production cutoff_height is above that range on both chains.
#
# `Osaka` is Limb, not Arsia: Mantle put two forks at Osaka level and `Arsia` is the
# later one. Pinning `Osaka` for an Arsia-era block gives the wrong gas schedule.
OP_SPEC=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Verify balances, nonces, code hashes and every touched storage slot against the node
# after each block. This is the only check that covers fee distribution -- the L1 fee,
# operator fee and base fee vaults move no gas and emit no log, so receipts and
# receiptsRoot cannot see them. Costs one extra round of reads per touched account.
# Default: false
STATE_VERIFY=true

# Block-level concurrency. Keep it at 1 and scale with more processes over disjoint
# ranges: every buffered block shares one task, which is where a lost wakeup can stall
# the run (see the comment at the stream in main.rs). Default: 1
CONCURRENCY=1

# Completed block numbers, appended and flushed as they finish; blocks already listed
# are skipped on restart. Give every shard its OWN file -- sharing one races the append
# and makes a restart skip another shard's blocks. Default: replay-progress.txt
PROGRESS_FILE=replay-progress.txt

# Print per-transaction detail for matching blocks too. Off by default because a long
# range would emit tens of GB, mostly bloom strings that only matter on failure.
# Mismatching blocks always print detail. Default: false
VERBOSE=false

# Per-request timeout, seconds. The default client has none, so one lost response hangs
# the run with nothing logged. Default: 30
REQUEST_TIMEOUT_SECS=30

# Ceiling on one block, seconds. Generous: it exists to break a hang, not to pace the
# run. Default: 300
BLOCK_TIMEOUT_SECS=300

# Dump each block's cache_db to cache_db_exports/block_*.json. Never enable for a long
# range: 22-260 KB per block. There is no import path and the output is not a test
# fixture. Default: false
EXPORT_CACHE_DB=false
