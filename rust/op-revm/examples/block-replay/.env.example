# ---- required ----

# Archive node. Must serve the range's historical state, receipts and
# debug_getRawTransaction.
MANTLE_URL=http://your-archive-node:8545

# Inclusive.
START_BLOCK=94355444
END_BLOCK=94365443

# ---- fork ----

# Leave empty. Each block's fork then comes from its own timestamp, which is what a
# range crossing an activation needs, and which gives Arsia for Arsia-era blocks.
# Setting it pins the whole range to one fork: a debugging tool, not a way to replay.
#
# Only 5000 and 5003 have a built-in schedule; any other chain (QA, devnet) replays by
# pinning OP_SPEC, which skips the schedule.
#
#   fork    OP_SPEC value   mainnet       sepolia
#   Arsia   Arsia           94,355,444    36,438,664   <- newest
#   Limb    Osaka           90,121,844    31,600,264   <- note: Limb, not Arsia
#   Skadi   Isthmus         84,073,844    25,552,264
#
# Below Skadi the ladder is not modelled and those blocks mismatch by design.
OP_SPEC=

# ---- optional ----

# Read from the endpoint. Set it only to assert which chain you expect; a disagreement
# stops the run.
# CHAIN_ID=5000

# Check balances, nonces, code hashes and touched slots against the node. The only check
# that covers fee distribution, since vault balances move no gas and emit no log.
# Default: false
STATE_VERIFY=true

# Keep at 1; scale with more processes over disjoint ranges. Default: 1
CONCURRENCY=1

# Resume file. Every shard needs its own. Default: replay-progress.txt
PROGRESS_FILE=replay-progress.txt

# Per-transaction detail for matching blocks too; tens of GB over a long range.
# Mismatches always print detail. Default: false
VERBOSE=false

# Seconds. Default: 30
REQUEST_TIMEOUT_SECS=30

# Seconds, per block, to break a hang rather than to pace the run. Default: 300
BLOCK_TIMEOUT_SECS=300

# Dumps cache_db to cache_db_exports/block_*.json, 22-260 KB per block, with no import
# path. Never for a long range. Default: false
EXPORT_CACHE_DB=false
